# Copy to .env (loaded by `node --env-file-if-exists=.env`).
SERVER_URL=http://localhost:4000
# Plaintext device key created by `npm run seed` or POST /api/v1/devices.
DEVICE_API_KEY=
# Samples per second per satellite (1..10).
SIM_HZ=5
# "index/count": simulate only satellites where position % count == index.
SIM_SHARD=0/1
# Optional comma-separated NORAD ids; empty = all satellites in data/satellites.json.
SIM_SATS=
# Simulated seconds per wall-clock second (orbit and physics run this much faster).
SIM_TIME_SCALE=1
# true = try a live CelesTrak TLE fetch once at boot (falls back to the snapshot silently).
TLE_REFRESH=false
