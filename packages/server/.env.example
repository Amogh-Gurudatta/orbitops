# Copy to packages/server/.env - loaded by `node --env-file-if-exists=.env`.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/orbitops?replicaSet=rs0&directConnection=true
# Comma-separated list of allowed browser origins (CORS + CSP websocket origin).
CLIENT_ORIGIN=http://localhost:5173
# Required (>= 32 chars) when NODE_ENV=production. Dev falls back to an insecure default with a warning.
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
# Bootstrap device key: seeded as a device (stored as sha256) when SEED_DEMO is on. The simulator uses it.
DEVICE_API_KEY=dev-simulator-key-change-me
# Telemetry persisted per satellite per second (downsampling to fit small Mongo tiers).
PERSIST_HZ=2
# TTL of raw telemetry in the time-series collection.
RAW_TTL_HOURS=6
# Serve packages/web/dist from this process (single-origin production deployment).
SERVE_WEB=false
# Seed demo users (viewer/operator/admin@orbitops.dev, password "orbitops"), satellites and ground stations.
SEED_DEMO=true
# Set when running behind a reverse proxy (Render): number of trusted hops.
TRUST_PROXY=0
LOG_LEVEL=info
# Per-device ingest limits: sustained events/second and burst events per 10 s.
DEVICE_EVENTS_PER_SEC=3000
DEVICE_BURST_EVENTS=6000
