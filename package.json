{
  "name": "orbitops",
  "version": "0.1.0",
  "private": true,
  "description": "OrbitOps \u2014 real-time satellite mission control telemetry platform (MERN + Socket.IO)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,sim,web -c gray,yellow,white \"npm run dev -w @orbitops/server\" \"npm run dev -w @orbitops/simulator\" \"npm run dev -w @orbitops/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "npm run seed -w @orbitops/server",
    "db:up": "docker compose up -d mongo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
